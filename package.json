    "@wordpress/babel-preset-default": "8.46.0",
    "@wordpress/dependency-extraction-webpack-plugin": "6.46.0",
    "@wordpress/icons": "13.1.0",
    "animate.css": "4.1.1",
    "array-move": "4.0.0",
    "babel-loader": "10.1.1",
    "classnames": "2.5.1",
    "clean-webpack-plugin": "4.0.0",
    "css-loader": "7.1.4",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
